{
  "name": "opencut",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:tools": "turbo run build --filter=@opencut/tools",
    "build:wasm": "bash script/build-audio-worklet && wasm-pack build rust/wasm --target bundler --out-dir pkg && bun run script/sync-wasm.ts",
    "build:web": "turbo run build --filter=@opencut/web",
    "build:website": "node apps/website/scripts/build.mjs",
    "dev:website": "node apps/website/scripts/serve.mjs",
    "deploy:web": "turbo run deploy --filter=@opencut/web",
    "dev:tools": "turbo run dev --filter=@opencut/tools",
    "dev:wasm": "cargo watch -w rust/crates -w rust/wasm/src -s \"bun run build:wasm\"",
    "dev:web": "turbo run dev --filter=@opencut/web",
    "format:web": "biome format apps/web/src/services/renderer --write --max-diagnostics=1000",
    "generate:fonts": "npx tsx apps/web/scripts/generate-font-sprites.ts",
    "lint:web": "biome lint apps/web/src --max-diagnostics=1000",
    "lint:web:fix": "biome lint apps/web/src --write --unsafe --max-diagnostics=1000",
    "preview:web": "turbo run preview --filter=@opencut/web",
    "publish:wasm": "bun run build:wasm && npm publish rust/wasm/pkg --access public",
    "start:tools": "turbo run start --filter=@opencut/tools",
    "test": "bun test",
    "test:local": "wasm-pack build rust/wasm --target nodejs --out-dir pkg-node --no-opt && bun test --preload ./script/test-wasm.ts",
    "build:audio": "bash script/build-audio-worklet"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "better-auth": "^1.4.15",
    "next": "^16.1.3",
    "opencut-wasm": "file:rust/wasm/pkg"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
